# URL of the deployed FastAPI service. Set this in the Vercel project settings
# as well — it is baked in at build time, so a change needs a redeploy.
#
# It must be the API host, never this frontend's own URL.
VITE_API_BASE_URL=https://pg-assistant-api.onrender.com

# true = answer from the built-in canned responses instead of calling the API
VITE_USE_MOCK_API=false

# Dev only: the Vite proxy target for /api. Has no effect in a production
# build — Vercel serves static files and there is no Vite server there.
VITE_API_TARGET=http://localhost:8000
