SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-service-role-key
SUPABASE_PUBLISHABLE_KEY=your-anon-key

# local  -> runs offline with transformers, no API key, no cost (384 dims)
# gemini -> free tier, needs GEMINI_API_KEY (768 dims)
# openai -> paid, needs OPENAI_API_KEY (1536 dims)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Must match the vector(N) size on document_chunks.embedding in database/schema.sql
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=32
# local provider only: cpu or cuda (auto-detected when unset)
EMBEDDING_DEVICE=

# Only needed if EMBEDDING_PROVIDER is gemini or openai
GEMINI_API_KEY=
OPENAI_API_KEY=

# Fallback key used if the provider-specific key above is not set
LLM_API_KEY=

# Retrieval defaults
RETRIEVAL_MATCH_COUNT=8
RETRIEVAL_SIMILARITY_THRESHOLD=0.3

# Chat LLM: openai | gemini | local
# local talks to an OpenAI-compatible server such as Ollama or LM Studio
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# Only used when LLM_PROVIDER=local
LOCAL_LLM_BASE_URL=http://localhost:11434/v1

# Per client IP unless marked global; 0 turns a limit off
RATE_LIMIT_CHAT_PER_MINUTE=10
RATE_LIMIT_CHAT_PER_DAY=200
RATE_LIMIT_CHAT_GLOBAL_PER_DAY=2000
RATE_LIMIT_RETRIEVE_PER_MINUTE=30
RATE_LIMIT_RETRIEVE_PER_DAY=500
RATE_LIMIT_RETRIEVE_GLOBAL_PER_DAY=5000

# OCR for scanned PDFs
OCR_DPI=200
